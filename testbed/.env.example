# Copy to .env.local — local dev only.
# The audit API: ascendra-commons-sandbox (its README's Quickstart starts it on :3010). The browser reaches it through
# this app's /sandbox-api proxy (next.config.ts), so the testbed works by any hostname and from other devices;
# server-side code (the dev sign-in) calls SANDBOX_API_URL directly.
NEXT_PUBLIC_API_URL=/sandbox-api
SANDBOX_API_URL=http://localhost:3010
# next-auth, for the dev sign-in (lib/dev-auth). Any long random string; dev only.
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=testbed-dev-secret-change-me-0123456789abcdef
